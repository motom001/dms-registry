{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/motom001/dms-registry/schema/manifest.schema.json",
  "title": "manifest.yaml eines DMS-Pakets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "beschreibung",
    "autor",
    "lizenz",
    "dms",
    "inhalt"
  ],
  "$defs": {
    "einstellungsfeld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schluessel",
        "name",
        "typ"
      ],
      "properties": {
        "schluessel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "typ": {
          "enum": [
            "text",
            "mehrzeilig",
            "zahl",
            "janein",
            "datum",
            "auswahl",
            "mehrfachauswahl",
            "geheim",
            "mappentyp",
            "feld",
            "benutzer",
            "rolle",
            "sicht",
            "adresse"
          ]
        },
        "hilfe": {
          "type": "string"
        },
        "pflicht": {
          "type": "boolean"
        },
        "standard": {},
        "optionen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "mappentyp": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39}$",
          "description": "bei typ feld: Mappentyp, aus dem ein Feld gewählt wird"
        },
        "mehrfach": {
          "const": true,
          "description": "DMS #658, ab 0.179.0: Verweis (mappentyp, benutzer, rolle, sicht) als Mehrfachauswahl; Wert ist eine Liste von Ids"
        },
        "schliesst_aus": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "description": "DMS #658, ab 0.179.0: anderes Feld desselben Verweistyps im Abschnitt; dieselbe Id nicht in beiden"
        },
        "beispiel": {
          "type": "string",
          "pattern": "^https?://[^\\s@?#]+$",
          "description": "bei typ adresse (DMS >=0.124.0): Beispiel im leeren Feld, z. B. http://ollama:11434/v1 – nie eine gespeicherte Vorgabe"
        }
      }
    },
    "abschnitt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abschnitt",
        "felder"
      ],
      "properties": {
        "abschnitt": {
          "type": "string",
          "minLength": 1
        },
        "hilfe": {
          "type": "string"
        },
        "felder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/einstellungsfeld"
          }
        }
      }
    },
    "liste": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liste",
        "name",
        "eintrag",
        "felder"
      ],
      "properties": {
        "liste": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eintrag": {
          "type": "string",
          "minLength": 1
        },
        "hilfe": {
          "type": "string"
        },
        "sortierbar": {
          "type": "boolean"
        },
        "felder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/einstellungsfeld"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,19}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "beschreibung": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "autor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "github"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "lizenz": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-3.0-or-later",
        "GPL-3.0-or-later",
        "AGPL-3.0-or-later",
        "CC0-1.0"
      ]
    },
    "dms": {
      "type": "string",
      "pattern": "^(>=|>|=|\\^|~)?\\d+\\.\\d+\\.\\d+( <\\d+\\.\\d+\\.\\d+)?$"
    },
    "symbol": {
      "description": "Optional (#98, #80 Stufe 2): Symbol im Katalog statt des Anfangsbuchstabens – Name eines Lucide-Symbols aus werkzeuge/symbole/ (REGELN.md, „Symbol“). Ein neues Symbol kommt nur über ein Issue dazu. Das DMS liest das Feld nicht.",
      "enum": [
        "car",
        "cloud-upload",
        "contact",
        "file-text",
        "files",
        "house",
        "image",
        "key-round",
        "languages",
        "mail",
        "message-circle-question-mark",
        "scan-barcode",
        "scan-text",
        "wallet"
      ]
    },
    "kuerzel": {
      "description": "Optional (#98): kurzes Zeichen unten rechts am Symbol, höchstens 3 Großbuchstaben – nur zusammen mit symbol. Bei Sprachen der ISO-639-Code der Sprache, nicht des Landes (FR, ES, UK für Ukrainisch, AR für Arabisch); zweistellig nach ISO 639-1, dreistellig nur ohne zweistelligen Code. Keine Flaggen.",
      "type": "string",
      "maxLength": 3,
      "pattern": "^[A-Z]{2,3}$"
    },
    "kategorien": {
      "description": "Optional (#84 Stufe 2): 1–2 Kategorien aus werkzeuge/kategorien.yaml. Gewinnt vor der Zuordnung dort. Das DMS liest das Feld nicht.",
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "vorlagen",
          "dateiformate",
          "volltext",
          "sprachen",
          "ki",
          "suche",
          "post",
          "sicherung",
          "entwickler"
        ]
      }
    },
    "ergaenzt": {
      "description": "Optional (motom001/dms#405): Dieses Paket ergänzt ein anderes, z. B. eine Zusatzsprache die Texterkennung. Das ergänzte Paket muss auch unter abhaengigkeiten stehen. Das DMS ab 0.151.0 zeigt Ergänzungen bei der Installation als Häkchen unter dem ergänzten Paket, gruppiert nach gruppe (eine kurze Frage ohne Fragezeichen, z. B. „Weitere Sprachen“); ältere DMS ignorieren das Feld. Kurzform: nur die Id.",
      "oneOf": [
        { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,19}$" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["paket"],
          "properties": {
            "paket": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,19}$" },
            "gruppe": { "type": "string", "minLength": 1, "maxLength": 40 }
          }
        }
      ]
    },
    "abhaengigkeiten": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,19}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(>=|>|=|\\^|~)?\\d+\\.\\d+\\.\\d+( <\\d+\\.\\d+\\.\\d+)?$"
      }
    },
    "inhalt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mappentypen": {
          "type": "string"
        },
        "sichten": {
          "type": "string"
        },
        "rollen": {
          "type": "string"
        },
        "beispiele": {
          "type": "string"
        },
        "wortlisten": {
          "type": "string",
          "description": "Gleichbedeutende Wörter für die Suche (ab DMS 0.127.0, dms: \">=0.127.0\")"
        },
        "automatisierungen": {
          "type": "string",
          "description": "Mitgelieferte Automatisierungen (ab Ablago 0.177.0, dms: \">=0.177.0\"), nach der Installation aus"
        }
      }
    },
    "sprache": {
      "description": "Sprachpaket (motom001/dms#731, Registry #116, ab Ablago 0.203.0): Das Paket bringt nur Texte – texte/<bereich>.json und beschriftungen/<paket>.yaml –, keinen Code und keine Inhalte. REGELN.md, „Sprachpakete“.",
      "type": "object",
      "additionalProperties": false,
      "required": ["kennung", "ablago", "maschinell"],
      "properties": {
        "kennung": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$", "not": { "enum": ["de", "en"] }, "description": "Sprachkennung wie fr oder pt-BR; Deutsch und Englisch sind in Ablago eingebaut." },
        "gebietsschema": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$", "description": "Für Datum, Zahlen und Beträge, z. B. fr-FR; fehlt: die Kennung." },
        "ablago": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "Ablago-Version, für die die Texte gemacht sind." },
        "maschinell": { "type": "boolean", "description": "Maschinell übersetzt: Ablago und Katalog zeigen „Maschinell übersetzt – Verbesserungen willkommen“." },
        "geprueft_von": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^<>]*$", "description": "Wer die Übersetzung geprüft hat (z. B. GitHub-Name); dann „Geprüft von …“." }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sprache",
        "quelle",
        "rechte"
      ],
      "properties": {
        "sprache": {
          "enum": [
            "rust",
            "go",
            "c",
            "assemblyscript",
            "javascript"
          ]
        },
        "quelle": {
          "type": "string"
        },
        "ereignisse": {
          "type": "array",
          "items": {
            "enum": [
              "post.angelegt",
              "dokument.hochgeladen",
              "texterkennung.fertig",
              "volltext.fertig",
              "paket.einstellungen_geaendert",
              "datei.umwandeln",
              "sicherung.fertig",
              "datei.volltext",
              "datei.archivfassung",
              "mappe.angelegt",
              "mappe.geaendert",
              "mappe.geloescht",
              "mappe.wiederhergestellt",
              "frist.erreicht"
            ]
          },
          "uniqueItems": true
        },
        "rechte": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lesen": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*|([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39})$"
              }
            },
            "schreiben": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*|([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39})$"
              }
            },
            "dokumente": {
              "enum": [
                "keine",
                "lesen",
                "schreiben"
              ]
            },
            "schnittstellen": {
              "type": "array",
              "description": "Schnittstellen des Kerns: dms:vektoren (DMS #442) – Vektoren zu Dokumenten speichern und ähnliche finden; braucht dokumente: lesen und dms: >=0.122.0. dms:antworten (DMS #444) – Fragen an die Ablage aus Ausschnitten des Kerns beantworten; braucht dms: >=0.124.0. dms:erkennen (DMS #511) – Felder für „Aus Dokument ausfüllen“ aus Text und JSON Schema des Kerns vorschlagen; braucht dms: >=0.125.0. dms:texterkennung (DMS #458) – Texterkennung für Scans und Bilder übernehmen; braucht dokumente: schreiben und dms: >=0.133.0. dms:umwandeln (DMS #577) – Dateien, die das DMS nicht selbst liest, in eine Fassung (PDF, PNG, JPEG) umwandeln; braucht dokumente: lesen, code.umwandeln, das Ereignis datei.umwandeln und dms: >=0.137.0. dms:sicherung-lesen (DMS #585) – die verschlüsselte Sicherung in Stücken lesen, außer Haus kopieren und je Sicherung zurückmelden; braucht das Ereignis sicherung.fertig und dms: >=0.142.0. dms:volltext (DMS #614) – den Volltext für Dateien liefern, die das DMS nicht selbst liest, ohne Schreibrecht auf Dokumente; braucht dokumente: lesen, code.volltext, das Ereignis datei.volltext und dms: >=0.145.0. dms:archivfassung (DMS #631) – zu Dokumenten mit fertigem Volltext ein durchsuchbares PDF/A (Archivfassung) ablegen, das Original bleibt unverändert; braucht dokumente: lesen, code.archivfassung, das Ereignis datei.archivfassung und dms: >=0.149.0",
              "items": {
                "enum": [
                  "dms:vektoren",
                  "dms:antworten",
                  "dms:erkennen",
                  "dms:texterkennung",
                  "dms:umwandeln",
                  "dms:sicherung-lesen",
                  "dms:volltext",
                  "dms:archivfassung"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "netz": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/\\s@?#]+(/[^\\s?#]*)?$"
          },
          "uniqueItems": true
        },
        "umwandeln": {
          "type": "array",
          "description": "Dateien umwandeln (DMS #577, nur mit dms:umwandeln): die Dateitypen (MIME), für die das Paket zuständig ist, z. B. image/tiff. PDF, JPEG und PNG liest das DMS selbst und sind nicht erlaubt.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$",
            "not": {
              "enum": [
                "application/pdf",
                "image/jpeg",
                "image/png"
              ]
            }
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "volltext": {
          "type": "array",
          "description": "Volltext aus Paketen (DMS #614, nur mit dms:volltext): die Dateitypen (MIME), für die das Paket den Volltext liefert, z. B. message/rfc822. PDF, JPEG und PNG liest das DMS selbst und sind nicht erlaubt.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$",
            "not": {
              "enum": [
                "application/pdf",
                "image/jpeg",
                "image/png"
              ]
            }
          },
          "minItems": 1,
          "maxItems": 40,
          "uniqueItems": true
        },
        "mappentypen": {
          "type": "array",
          "description": "Mappentypen für Ereignisse (DMS #670, ab 0.153.0): Pflicht mit den Mappen-Ereignissen mappe.angelegt, mappe.geaendert, mappe.geloescht, mappe.wiederhergestellt und frist.erreicht – und nur mit ihnen. Schlüssel eigener Mappentypen ohne Präfix; ab DMS 0.166.0 (#686) auch fremde wie paket:typ oder dms:post und * (alle, die das Paket lesen darf). Das Paket muss sie lesen dürfen.",
          "items": {
            "type": "string",
            "pattern": "^(\\*|([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39})$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "archivfassung": {
          "type": "object",
          "description": "Archivfassung (DMS #631, nur mit dms:archivfassung): die Dateitypen (MIME), zu denen das Paket ein PDF/A ablegt – PDF, JPEG und PNG sind erlaubt –, und optional auswahl (DMS #660, ab 0.176.0): je Art – pdf_text (PDFs mit Text), pdf_scan (gescannte PDFs), bilder (Fotos und Bilder) – der Schlüssel einer Einstellung vom Typ janein (an: diese Dokumente bekommen eine Archivfassung; fehlt die Art, immer).",
          "additionalProperties": false,
          "required": [
            "typen"
          ],
          "properties": {
            "typen": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$"
              },
              "minItems": 1,
              "maxItems": 40,
              "uniqueItems": true
            },
            "auswahl": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "properties": {
                "pdf_text": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "pdf_scan": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
                "bilder": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }
              }
            }
          }
        },
        "einstellungen": {
          "type": "array",
          "description": "Abschnitte und Listen (höchstens zwei Ebenen); daraus baut das DMS ein Formular",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/abschnitt"
              },
              {
                "$ref": "#/$defs/liste"
              }
            ]
          }
        },
        "aktionen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schluessel",
              "name"
            ],
            "properties": {
              "schluessel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hilfe": {
                "type": "string"
              },
              "bestaetigen": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
