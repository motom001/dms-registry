{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/motom001/dms-registry/schema/manifest.schema.json",
  "title": "manifest.yaml eines DMS-Pakets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "beschreibung",
    "autor",
    "lizenz",
    "dms",
    "inhalt"
  ],
  "$defs": {
    "einstellungsfeld": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schluessel",
        "name",
        "typ"
      ],
      "properties": {
        "schluessel": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "typ": {
          "enum": [
            "text",
            "mehrzeilig",
            "zahl",
            "janein",
            "datum",
            "auswahl",
            "mehrfachauswahl",
            "geheim",
            "mappentyp",
            "feld",
            "benutzer",
            "rolle",
            "sicht",
            "adresse"
          ]
        },
        "hilfe": {
          "type": "string"
        },
        "pflicht": {
          "type": "boolean"
        },
        "standard": {},
        "optionen": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "mappentyp": {
          "type": "string",
          "pattern": "^([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39}$",
          "description": "bei typ feld: Mappentyp, aus dem ein Feld gewählt wird"
        },
        "beispiel": {
          "type": "string",
          "pattern": "^https?://[^\\s@?#]+$",
          "description": "bei typ adresse (DMS >=0.124.0): Beispiel im leeren Feld, z. B. http://ollama:11434/v1 – nie eine gespeicherte Vorgabe"
        }
      }
    },
    "abschnitt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "abschnitt",
        "felder"
      ],
      "properties": {
        "abschnitt": {
          "type": "string",
          "minLength": 1
        },
        "hilfe": {
          "type": "string"
        },
        "felder": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/einstellungsfeld"
          }
        }
      }
    },
    "liste": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "liste",
        "name",
        "eintrag",
        "felder"
      ],
      "properties": {
        "liste": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,39}$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "eintrag": {
          "type": "string",
          "minLength": 1
        },
        "hilfe": {
          "type": "string"
        },
        "sortierbar": {
          "type": "boolean"
        },
        "felder": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/einstellungsfeld"
          }
        }
      }
    }
  },
  "properties": {
    "schema": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{1,19}$"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 60
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "beschreibung": {
      "type": "string",
      "minLength": 10,
      "maxLength": 300
    },
    "autor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "github"
      ],
      "properties": {
        "name": {
          "type": "string"
        },
        "github": {
          "type": "string",
          "pattern": "^[A-Za-z0-9-]+$"
        }
      }
    },
    "lizenz": {
      "enum": [
        "MIT",
        "Apache-2.0",
        "BSD-2-Clause",
        "BSD-3-Clause",
        "MPL-2.0",
        "LGPL-3.0-or-later",
        "GPL-3.0-or-later",
        "AGPL-3.0-or-later",
        "CC0-1.0"
      ]
    },
    "dms": {
      "type": "string",
      "pattern": "^(>=|>|=|\\^|~)?\\d+\\.\\d+\\.\\d+( <\\d+\\.\\d+\\.\\d+)?$"
    },
    "abhaengigkeiten": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9_]{1,19}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^(>=|>|=|\\^|~)?\\d+\\.\\d+\\.\\d+( <\\d+\\.\\d+\\.\\d+)?$"
      }
    },
    "inhalt": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mappentypen": {
          "type": "string"
        },
        "sichten": {
          "type": "string"
        },
        "rollen": {
          "type": "string"
        },
        "beispiele": {
          "type": "string"
        },
        "wortlisten": {
          "type": "string",
          "description": "Gleichbedeutende Wörter für die Suche (ab DMS 0.127.0, dms: \">=0.127.0\")"
        }
      }
    },
    "code": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sprache",
        "quelle",
        "rechte"
      ],
      "properties": {
        "sprache": {
          "enum": [
            "rust",
            "go",
            "c",
            "assemblyscript",
            "javascript"
          ]
        },
        "quelle": {
          "type": "string"
        },
        "ereignisse": {
          "type": "array",
          "items": {
            "enum": [
              "post.angelegt",
              "dokument.hochgeladen",
              "texterkennung.fertig",
              "volltext.fertig",
              "paket.einstellungen_geaendert",
              "datei.umwandeln"
            ]
          },
          "uniqueItems": true
        },
        "rechte": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "lesen": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*|([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39})$"
              }
            },
            "schreiben": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^(\\*|([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39})$"
              }
            },
            "dokumente": {
              "enum": [
                "keine",
                "lesen",
                "schreiben"
              ]
            },
            "schnittstellen": {
              "type": "array",
              "description": "Schnittstellen des Kerns: dms:vektoren (DMS #442) – Vektoren zu Dokumenten speichern und ähnliche finden; braucht dokumente: lesen und dms: >=0.122.0. dms:antworten (DMS #444) – Fragen an die Ablage aus Ausschnitten des Kerns beantworten; braucht dms: >=0.124.0. dms:erkennen (DMS #511) – Felder für „Aus Dokument ausfüllen“ aus Text und JSON Schema des Kerns vorschlagen; braucht dms: >=0.125.0. dms:texterkennung (DMS #458) – Texterkennung für Scans und Bilder übernehmen; braucht dokumente: schreiben und dms: >=0.133.0. dms:umwandeln (DMS #577) – Dateien, die das DMS nicht selbst liest, in eine Fassung (PDF, PNG, JPEG) umwandeln; braucht dokumente: lesen, code.umwandeln, das Ereignis datei.umwandeln und dms: >=0.137.0",
              "items": {
                "enum": [
                  "dms:vektoren",
                  "dms:antworten",
                  "dms:erkennen",
                  "dms:texterkennung",
                  "dms:umwandeln"
                ]
              },
              "uniqueItems": true
            }
          }
        },
        "netz": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^https://[^/\\s@?#]+(/[^\\s?#]*)?$"
          },
          "uniqueItems": true
        },
        "umwandeln": {
          "type": "array",
          "description": "Dateien umwandeln (DMS #577, nur mit dms:umwandeln): die Dateitypen (MIME), für die das Paket zuständig ist, z. B. image/tiff. PDF, JPEG und PNG liest das DMS selbst und sind nicht erlaubt.",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9!#$&^_.+-]{0,62}/[a-z0-9][a-z0-9!#$&^_.+-]{0,62}$",
            "not": {
              "enum": [
                "application/pdf",
                "image/jpeg",
                "image/png"
              ]
            }
          },
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true
        },
        "einstellungen": {
          "type": "array",
          "description": "Abschnitte und Listen (höchstens zwei Ebenen); daraus baut das DMS ein Formular",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/abschnitt"
              },
              {
                "$ref": "#/$defs/liste"
              }
            ]
          }
        },
        "aktionen": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schluessel",
              "name"
            ],
            "properties": {
              "schluessel": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,39}$"
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "hilfe": {
                "type": "string"
              },
              "bestaetigen": {
                "type": "boolean"
              }
            }
          }
        }
      }
    }
  }
}
