{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/motom001/dms-registry/schema/inhalt.schema.json",
  "title": "Inhalte eines DMS-Pakets (mappentypen.yaml, sichten.yaml, beispiele.yaml, wortlisten.yaml, automatisierungen.yaml)",
  "$defs": {
    "schluessel": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
    "datumsgrenze": { "anyOf": [{ "const": "heute" }, { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }] },
    "typverweis": { "type": "string", "pattern": "^([a-z][a-z0-9_]{1,19}:)?[a-z][a-z0-9_]{0,39}$" },
    "beschriftung": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^<>]*$" },
    "sprachkennung": { "type": "string", "pattern": "^[a-z]{2,3}(-[A-Z]{2})?$" },
    "teile_name": { "type": "object", "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/beschriftung" }, "beschreibung": { "$ref": "#/$defs/beschriftung" } } },
    "teile_register": { "type": "object", "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/beschriftung" } } },
    "teile_feld": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "label": { "$ref": "#/$defs/beschriftung" }, "hilfe": { "$ref": "#/$defs/beschriftung" },
        "optionen": { "type": "object", "description": "Fester Wert (aus optionen) → Text", "additionalProperties": { "$ref": "#/$defs/beschriftung" } }
      }
    },
    "beschriftungen_name": {
      "description": "Beschriftungen je Sprache (Ablago #728, Registry #135): Sprache → name, beschreibung. Der Ausgangstext (name) bleibt Deutsch.",
      "type": "object", "propertyNames": { "$ref": "#/$defs/sprachkennung" }, "maxProperties": 30, "additionalProperties": { "$ref": "#/$defs/teile_name" }
    },
    "beschriftungen_register": {
      "type": "object", "propertyNames": { "$ref": "#/$defs/sprachkennung" }, "maxProperties": 30, "additionalProperties": { "$ref": "#/$defs/teile_register" }
    },
    "beschriftungen_feld": {
      "description": "Beschriftungen je Sprache (Ablago #728, Registry #135): Sprache → label, hilfe, optionen (fester Wert → Text). beschriftungen.de nur für optionen.",
      "type": "object", "propertyNames": { "$ref": "#/$defs/sprachkennung" }, "maxProperties": 30, "additionalProperties": { "$ref": "#/$defs/teile_feld" }
    },
    "feld": {
      "type": "object", "required": ["key", "label", "typ"],
      "properties": {
        "key": { "$ref": "#/$defs/schluessel" },
        "label": { "type": "string", "minLength": 1 },
        "typ": { "enum": ["text", "langtext", "formatiert", "zahl", "betrag", "datum", "janein", "auswahl", "referenz", "passwort"] },
        "pflicht": { "type": "boolean" }, "eindeutig": { "type": "boolean" }, "hilfe": { "type": "string" },
        "standard": {}, "minLen": { "type": "integer" }, "maxLen": { "type": "integer" }, "muster": { "type": "string" },
        "beschriftungen": { "$ref": "#/$defs/beschriftungen_feld" },
        "min": { "description": "Zahl und Betrag: Zahl. Datum (DMS ab 0.121.0, #535): „heute“ oder JJJJ-MM-TT – frühestes erlaubtes Datum.", "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/datumsgrenze" }] },
        "max": { "description": "Zahl und Betrag: Zahl. Datum (DMS ab 0.121.0, #535): „heute“ oder JJJJ-MM-TT – spätestes erlaubtes Datum, z. B. heute für einen Geburtstag.", "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/datumsgrenze" }] }, "nachkomma": { "type": "integer" }, "waehrung": { "type": "string" },
        "optionen": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "mehrfach": { "type": "boolean" },
        "ziel": { "$ref": "#/$defs/typverweis" },
        "verweisart": { "enum": ["zugehoerigkeit", "bezug"] },
        "frist": { "type": "object", "required": ["vorlauf", "einheit"], "properties": { "vorlauf": { "type": "integer", "minimum": 0 }, "einheit": { "enum": ["tage", "wochen", "monate"] }, "wiederholung": { "type": "integer" } } },
        "aus_text": {
          "description": "Text → Verweis (DMS ab 0.120.0, DMS #534): Kennung des bisherigen Textfelds, aus dem sich dieses Verweisfeld nach einem Update füllen lässt. Das DMS legt den Verweis zusätzlich an; umgewandelt wird erst nach einer Vorschau in der Werkbank.",
          "$ref": "#/$defs/schluessel"
        },
        "format": {
          "description": "Nur bei typ text (DMS ab 0.121.0, #535): Format der Angabe. Neue und geänderte Werte müssen passen, gespeicherte bleiben gültig.",
          "enum": ["email", "telefon", "internetseite", "iban", "plz"]
        },
        "landFeld": {
          "description": "Bei format plz: Kennung des Felds mit dem Land (Text oder Auswahl). Deutschland oder leer heißt genau 5 Ziffern.",
          "$ref": "#/$defs/schluessel"
        },
        "erkennung": {
          "description": "Für die Erkennung nutzen (DMS ab 0.113.0, #336/#391): {} markiert das Feld; art sagt, was darin steht (fehlt: aus Feldart und Bezeichnung); hinweis ist der Erkennungshinweis.",
          "type": "object", "additionalProperties": false,
          "properties": {
            "art": { "enum": ["name", "vorname", "nachname", "funktion", "nummer", "iban", "ustid", "email", "internet", "telefon", "mobil", "fax", "strasse", "hausnummer", "plz", "ort", "datum", "betrag", "verweis", "auswahl"] },
            "hinweis": { "type": "string", "maxLength": 300 }
          }
        }
      },
      "allOf": [
        { "if": { "properties": { "typ": { "const": "auswahl" } } }, "then": { "required": ["optionen"] } },
        { "if": { "properties": { "typ": { "const": "referenz" } } }, "then": { "required": ["ziel"] } },
        { "if": { "required": ["aus_text"] }, "then": { "properties": { "typ": { "const": "referenz" } } } }
      ]
    },
    "register": {
      "type": "object", "required": ["key", "name", "art"],
      "properties": {
        "key": { "$ref": "#/$defs/schluessel" }, "name": { "type": "string" },
        "art": { "enum": ["felder", "dokumente", "verknuepfungen", "protokoll"] },
        "felder": { "type": "array", "items": { "$ref": "#/$defs/schluessel" } },
        "quellen": { "type": "array", "items": { "type": "object", "required": ["typ", "feld"], "properties": { "typ": { "$ref": "#/$defs/typverweis" }, "feld": { "$ref": "#/$defs/schluessel" } } } },
        "volltext": { "type": "boolean" },
        "beschriftungen": { "$ref": "#/$defs/beschriftungen_register" }
      }
    },
    "mappentyp": {
      "type": "object", "required": ["schluessel", "name", "beschreibung", "felder", "register"],
      "properties": {
        "schluessel": { "$ref": "#/$defs/schluessel" }, "name": { "type": "string" }, "beschreibung": { "type": "string" },
        "titelVorlage": { "type": "string" },
        "felder": { "type": "array", "items": { "$ref": "#/$defs/feld" } },
        "register": { "type": "array", "items": { "$ref": "#/$defs/register" }, "minItems": 1 },
        "trefferliste": { "type": "array", "items": { "type": "string" } },
        "beschriftungen": { "$ref": "#/$defs/beschriftungen_name" }
      }
    },
    "sicht": {
      "type": "object", "required": ["schluessel", "name"],
      "properties": {
        "schluessel": { "$ref": "#/$defs/schluessel" }, "name": { "type": "string" }, "beschreibung": { "type": "string" },
        "eltern": { "$ref": "#/$defs/schluessel" },
        "typen": { "type": "array", "items": { "anyOf": [{ "$ref": "#/$defs/typverweis" }, { "const": "*", "description": "alle Mappentypen (ab Ablago 0.182.0, DMS #725), steht allein" }] } },
        "fremde_typen": { "type": "array", "description": "Mappentypen, die das Paket nicht mitbringt (DMS #656, ab 0.178.0): Ablago ordnet sie über die Kennung zu, sonst wird die Ansicht übersprungen.", "items": { "type": "object", "required": ["kennung"], "additionalProperties": false, "properties": { "kennung": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "name": { "type": "string" } } } },
        "bedingungen": { "type": "array", "items": { "type": "object", "required": ["feld", "operator"], "properties": { "feld": { "type": "string" }, "operator": { "type": "string" }, "wert": {} } } },
        "trefferliste": { "type": "string" },
        "beschriftungen": { "$ref": "#/$defs/beschriftungen_name" },
        "symbol": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Symbol der Ansicht (DMS #428): ein Lucide-Name aus der festen Liste in shared/src/ansichtsymbole.ts des DMS, z. B. house, car, euro, mail. Unbekannte Namen zeigt Ablago ohne Symbol." }
      }
    },
    "beispiel": {
      "type": "object", "required": ["typ", "werte"], "additionalProperties": false,
      "properties": {
        "typ": { "$ref": "#/$defs/typverweis" }, "schluessel": { "$ref": "#/$defs/schluessel" }, "werte": { "type": "object" },
        "dokumente": {
          "description": "Beispiel-Dokumente (Ablago #878, ab 0.223.0): Dateien unter inhalt/beispiele/, nur PDF, PNG und JPEG mit erfundenen Inhalten.",
          "type": "array", "items": { "$ref": "#/$defs/beispiel_dokument" }
        }
      }
    },
    "beispiel_dokument": {
      "type": "object", "required": ["datei"], "additionalProperties": false,
      "properties": {
        "datei": { "type": "string", "description": "Pfad relativ zu inhalt/, z. B. beispiele/heizung/wartungsvertrag.pdf", "pattern": "^beispiele/([A-Za-z0-9_-][A-Za-z0-9._-]{0,79}/){0,4}[A-Za-z0-9_-][A-Za-z0-9._-]{0,99}\\.([Pp][Dd][Ff]|[Pp][Nn][Gg]|[Jj][Pp][Ee]?[Gg])$" },
        "titel": { "type": "string", "description": "Name des Dokuments in Ablago (ohne Endung hängt Ablago die der Datei an)", "minLength": 1, "maxLength": 200, "pattern": "^[^/\\\\]+$" },
        "datum": { "type": "string", "description": "„Hochgeladen am“ (JJJJ-MM-TT)", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "register": { "$ref": "#/$defs/schluessel", "description": "Dokumentenregister des Mappentyps; ohne Angabe das erste" }
      }
    }
  },
  "mappentypen": { "type": "array", "items": { "$ref": "#/$defs/mappentyp" } },
  "sprachtexte": {
    "description": "Sprachpaket (Ablago #731): texte/<bereich>.json – flach, Schlüssel wie in den Sprachdateien von Ablago, nur Texte.",
    "type": "object", "propertyNames": { "pattern": "^[a-z0-9]+([.-][A-Za-z0-9]+)*(_(zero|one|two|few|many|other))?$" },
    "additionalProperties": { "type": "string", "maxLength": 4000 }
  },
  "sprachbeschriftung": {
    "description": "Sprachpaket (Ablago #731): beschriftungen/<paket>.yaml – Mappentypen und Ansichten des Pakets in der Sprache des Sprachpakets, mit den Schlüsseln des Pakets (ohne Präfix).",
    "type": "object", "additionalProperties": false,
    "properties": {
      "mappentypen": {
        "type": "object", "propertyNames": { "$ref": "#/$defs/schluessel" },
        "additionalProperties": {
          "type": "object", "additionalProperties": false,
          "properties": {
            "name": { "$ref": "#/$defs/beschriftung" }, "beschreibung": { "$ref": "#/$defs/beschriftung" },
            "felder": { "type": "object", "propertyNames": { "$ref": "#/$defs/schluessel" }, "additionalProperties": { "$ref": "#/$defs/teile_feld" } },
            "register": { "type": "object", "propertyNames": { "$ref": "#/$defs/schluessel" }, "additionalProperties": { "$ref": "#/$defs/teile_register" } }
          }
        }
      },
      "sichten": { "type": "object", "propertyNames": { "$ref": "#/$defs/schluessel" }, "additionalProperties": { "$ref": "#/$defs/teile_name" } }
    }
  },
  "sichten": { "type": "array", "items": { "$ref": "#/$defs/sicht" } },
  "beispiele": { "type": "array", "items": { "$ref": "#/$defs/beispiel" } },
  "wortlisten": {
    "description": "Gruppen gleichbedeutender Wörter für die Suche (DMS #356, ab 0.127.0): Wer eines sucht, findet auch die anderen.",
    "type": "array", "maxItems": 1000,
    "items": {
      "type": "object", "required": ["woerter"], "additionalProperties": false,
      "properties": {
        "woerter": { "type": "array", "minItems": 2, "maxItems": 20, "items": { "type": "string", "minLength": 2, "maxLength": 60 } }
      }
    }
  },
  "automatisierungen": {
    "description": "Mitgelieferte Automatisierungen (DMS #712, Registry #108, ab 0.177.0): nach der Installation aus, beim Installieren wählbar. Genau eine Wenn-Karte, Und optional, mindestens eine Dann-Karte. Keine festen Personen oder Rollen.",
    "type": "array", "maxItems": 100,
    "items": {
      "type": "object", "required": ["schluessel", "name", "wenn", "dann"], "additionalProperties": false,
      "properties": {
        "schluessel": { "$ref": "#/$defs/schluessel" },
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "beschreibung": { "type": "string", "maxLength": 500 },
        "wenn": {
          "type": "object", "required": ["art"], "additionalProperties": false,
          "properties": {
            "art": { "type": "string" }, "typ": { "$ref": "#/$defs/typverweis" }, "feld": { "type": "string" },
            "vorlauf": { "type": "integer" }, "einheit": { "enum": ["tage", "wochen", "monate"] },
            "uhrzeit": { "type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$" },
            "wiederholung": { "type": ["integer", "null"], "minimum": 1, "maximum": 120 },
            "tage": { "type": "array", "minItems": 1, "maxItems": 7, "items": { "type": "integer", "minimum": 1, "maximum": 7 }, "description": "Zeitplan (DMS #678): Wochentage 1 = Montag … 7 = Sonntag" },
            "feiertage": { "type": "boolean", "description": "Zeitplan: nicht an Feiertagen" },
            "jeBenutzer": { "type": "boolean", "description": "Zeitplan: für jeden aktiven Benutzer einmal" },
            "profilzeit": { "type": "boolean", "description": "Zeitplan je Benutzer: Uhrzeit, Wochentage und Feiertage aus dem Profil" }
          }
        },
        "und": { "type": "object", "additionalProperties": false, "properties": { "modus": { "enum": ["alle", "eine"] }, "karten": { "type": "array" } } },
        "dann": {
          "type": "array", "minItems": 1, "maxItems": 20,
          "items": {
            "type": "object", "required": ["art"], "additionalProperties": false,
            "properties": {
              "art": { "enum": ["aufgabe", "feld", "stopp", "zusammenfassung", "favoriten", "anmeldeschutz"] }, "was": { "enum": ["sammel", "konto"] }, "als": { "enum": ["aufgabe", "benachrichtigung"] },
              "text": { "type": "string", "maxLength": 2000 }, "faellig": { "type": ["integer", "null"] }, "werte": { "type": "object" },
              "empfaenger": { "type": "array", "items": { "type": "object", "required": ["art"], "additionalProperties": false,
                "properties": { "art": { "type": "string" }, "feld": { "type": "string" }, "sonst": { "enum": ["ersteller"] } } } }
            }
          }
        }
      }
    }
  }
}
