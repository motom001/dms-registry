{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/motom001/dms-registry/schema/katalog.schema.json",
  "title": "katalog.json der DMS-Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "erstellt", "quelle", "pakete"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,19}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "bereich": { "type": "string", "pattern": "^(>=|>|=|\\^|~)?\\d+\\.\\d+\\.\\d+( <\\d+\\.\\d+\\.\\d+)?$" },
    "benannt": {
      "type": "object", "additionalProperties": false, "required": ["schluessel", "name"],
      "properties": { "schluessel": { "type": "string" }, "name": { "type": "string" } }
    },
    "paketversion": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "dms", "abhaengigkeiten", "inhalt", "code", "archiv", "sha256", "groesse", "veroeffentlicht", "quelle", "readme", "changelog"],
      "properties": {
        "version": { "$ref": "#/$defs/version" },
        "dms": { "$ref": "#/$defs/bereich" },
        "abhaengigkeiten": { "type": "object", "propertyNames": { "$ref": "#/$defs/id" }, "additionalProperties": { "$ref": "#/$defs/bereich" } },
        "inhalt": {
          "type": "object", "additionalProperties": false, "required": ["mappentypen", "sichten", "beispiele"],
          "properties": {
            "mappentypen": { "type": "array", "items": { "$ref": "#/$defs/benannt" } },
            "sichten": { "type": "array", "items": { "$ref": "#/$defs/benannt" } },
            "beispiele": { "type": "integer", "minimum": 0 }
          }
        },
        "code": { "type": "boolean" },
        "archiv": { "type": "string", "description": "Adresse des Archivs, relativ zu katalog.json" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "groesse": { "type": "integer", "minimum": 1 },
        "veroeffentlicht": { "type": "string", "format": "date-time" },
        "quelle": { "type": "string", "format": "uri" },
        "readme": { "type": "string", "format": "uri" },
        "changelog": { "type": "string", "format": "uri" }
      }
    },
    "paket": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "beschreibung", "autor", "lizenz", "aktuell", "versionen"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "name": { "type": "string" },
        "beschreibung": { "type": "string" },
        "autor": {
          "type": "object", "additionalProperties": false, "required": ["name", "github"],
          "properties": { "name": { "type": "string" }, "github": { "type": "string" } }
        },
        "lizenz": { "type": "string" },
        "aktuell": { "$ref": "#/$defs/version" },
        "versionen": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/paketversion" }, "description": "neueste zuerst" }
      }
    }
  },
  "properties": {
    "format": { "const": 1 },
    "erstellt": { "type": "string", "format": "date-time" },
    "quelle": { "type": "string", "format": "uri" },
    "signatur": { "type": ["null", "object"], "description": "Vorbereitet für eine spätere Stufe; heute immer null" },
    "pakete": { "type": "array", "items": { "$ref": "#/$defs/paket" } }
  }
}
