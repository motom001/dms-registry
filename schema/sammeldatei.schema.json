{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/motom001/dms-registry/schema/sammeldatei.schema.json",
  "title": "sammeldatei.json – Verzeichnis einer Sammeldatei (mehrere Pakete in einer Datei)",
  "description": "Eine Sammeldatei ist ein ZIP mit genau: sammeldatei.json, optional LIESMICH.txt und je Paket pakete/<id>-<version>.zip – das unveränderte Archiv aus dem Katalog. Das DMS prüft Größe und SHA-256 jedes Archivs gegen dieses Verzeichnis und, wenn es den offiziellen Katalog kennt, auch gegen katalog.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "art", "erstellt", "quelle", "katalog", "dms", "pakete"],
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]{1,19}$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" }
  },
  "properties": {
    "format": { "const": 1 },
    "art": { "const": "dms-sammeldatei" },
    "erstellt": { "type": "string", "description": "Zeitpunkt des Zusammenstellens (ISO 8601)" },
    "quelle": { "type": "string", "description": "Registry, aus der die Pakete stammen" },
    "katalog": { "type": "string", "description": "Adresse der katalog.json, aus der Prüfsummen und Archive stammen" },
    "dms": { "type": ["string", "null"], "pattern": "^\\d+\\.\\d+\\.\\d+$", "description": "DMS-Version, für die zusammengestellt wurde (null: neueste Paketversionen)" },
    "pakete": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "version", "name", "archiv", "sha256", "groesse", "gewaehlt"],
        "properties": {
          "id": { "$ref": "#/$defs/id" },
          "version": { "$ref": "#/$defs/version" },
          "name": { "type": "string" },
          "archiv": { "type": "string", "pattern": "^pakete/[a-z][a-z0-9_]{1,19}-\\d+\\.\\d+\\.\\d+\\.zip$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "groesse": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "gewaehlt": { "type": "boolean", "description": "selbst gewählt (false: als Abhängigkeit mitgenommen)" }
        }
      }
    }
  }
}
